{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "install": {
      "commands": ["pip install -r requirements.txt"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["python manage.py collectstatic --noinput"]
    }
  },
  "deploy": {
    "inputs": [{ "step": "build", "include": ["."] }],
    "startCommand": "python manage.py migrate --noinput && gunicorn contemplart.wsgi:application"
  }
}
