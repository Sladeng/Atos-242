DJANGO_SETTINGS_MODULE=contemplart.settings.dev
SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Producao (Railway): DJANGO_SETTINGS_MODULE=contemplart.settings.prod
# ALLOWED_HOSTS=seu-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://seu-app.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Local (docker-compose.yml) usa as variaveis POSTGRES_* abaixo.
# Railway injeta DATABASE_URL automaticamente via addon Postgres -
# nao precisa preencher isso a mao em producao.
DATABASE_URL=postgres://contemplart:contemplart@localhost:5432/contemplart

POSTGRES_DB=contemplart
POSTGRES_USER=contemplart
POSTGRES_PASSWORD=contemplart

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
