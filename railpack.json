{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "build": {
      "inputs": [{ "step": "install" }, { "local": true, "include": ["."] }],
      "commands": ["python manage.py collectstatic --noinput"]
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate --noinput && gunicorn contemplart.wsgi:application"
  }
}
